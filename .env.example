# ── Required everywhere ─────────────────────────────────────────────────────
# 32 random bytes, base64:   openssl rand -base64 32
# Encrypts stored statement files. Keep a copy somewhere safe (password manager):
# without it, stored originals can't be decrypted (your transactions are unaffected).
STATEMENT_ENCRYPTION_KEY=""

# Postgres. On Vercel the Neon integration sets both of these for you.
DATABASE_URL="postgresql://postgres@localhost:5433/tandem"
DATABASE_URL_UNPOOLED="postgresql://postgres@localhost:5433/tandem"

# ── Optional ────────────────────────────────────────────────────────────────
# Public address used in invite links. Defaults to the address you're browsing.
# APP_URL="https://tandem-xyz.vercel.app"

# Integration tests: any Postgres; each test file uses a throwaway schema.
# TEST_DATABASE_URL="postgresql://postgres@localhost:5433/postgres"
